# ポート番号（デフォルト: 3000）
PORT=3000

# 待受アドレス（デフォルト: 0.0.0.0 で全インターフェースから受付）
HOST=0.0.0.0

# 1ファイルあたりの最大容量（バイト数、デフォルト: 500 MiB = 524288000）
MAX_FILE_SIZE=524288000

# 全体保存容量の最大値（バイト数、デフォルト: 5 GiB = 5368709120）
MAX_TOTAL_SIZE=5368709120

# ファイル保存期間（秒、デフォルト: 3600 = 1時間）
EXPIRE_SECONDS=3600

# 期限切れファイル自動削除の走査周期（ミリ秒、デフォルト: 60000 = 1分）
CLEANUP_INTERVAL_MS=60000
